<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title><%= settings.siteName %> - <%= settings.tagline %></title><meta name="description" content="Live score, streaming, prediksi, klasemen dan berita bola terbaru."><link rel="icon" href="<%= settings.favicon || '/favicon.svg' %>"><link rel="preconnect" href="https://media.api-sports.io"><link rel="stylesheet" href="/style.css"><style>:root{--brand:<%= settings.primary %>}</style></head>
<body data-path="<%= path %>"><header><div class="nav"><a href="/" class="brand"><% if(settings.logo){ %><img src="<%= settings.logo %>" alt=""><% } else { %><b>BOLA</b><span>UTAMA</span><small>PUSAT BOLA UTAMA</small><% } %></a><nav><a href="/">Beranda</a><a href="/livescore">Live Score</a><a href="/prediksi">Prediksi</a><a href="/klasemen">Klasemen</a><a href="/berita">Berita Olahraga</a></nav><div class="head-right"><span id="clock">--:--</span><% if(user){ %><a href="/profile">◉ <%= user.displayName %></a><% }else{ %><a href="/login">Masuk</a><a class="pill" href="/register">Daftar</a><% } %></div></div></header>
<main id="app"><div class="loading"><span></span> Memuat BOLA UTAMA...</div></main>
<footer><div class="footer-grid"><div class="brand"><b>BOLA</b><span>UTAMA</span></div><div><h4>Menu</h4><a href="/">Beranda</a><a href="/livescore">Live Score</a><a href="/prediksi">Prediksi</a><a href="/klasemen">Klasemen</a><a href="/berita">Berita Olahraga</a></div><div><h4>Sepak Bola</h4><span>Champions League</span><span>Europa League</span><span>Premier League</span><span>LaLiga</span><span>Serie A</span></div><div><h4>Olahraga lainnya</h4><span>Bola Basket Skor</span><span>Voli Skor</span><span>Baseball Skor</span><span>Tenis Skor</span><span>Hockey Skor</span></div></div><p><%= settings.footerText %></p></footer>
<button id="top" aria-label="Kembali ke atas">⌃</button><nav class="mobile-nav"><a href="/">⌂ <span>Beranda</span></a><a href="/livescore">▣ <span>Live Score</span></a><a href="/prediksi">◎ <span>Prediksi</span></a><a href="/klasemen">▥ <span>Klasemen</span></a><a href="/berita">▤ <span>Berita</span></a><a href="/profile">● <span>Profil</span></a></nav>
<script>window.__USER__=<%- JSON.stringify(user||null) %>;</script><script src="/socket.io/socket.io.js"></script><script src="https://cdn.jsdelivr.net/npm/hls.js@1"></script><script src="/app.js"></script><script src="/enhancements.js"></script></body></html>
